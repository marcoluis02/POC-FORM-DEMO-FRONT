# Servidor
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT_MS=15000
# Subir fotos/PDF tarda mas que una peticion normal
VITE_UPLOAD_TIMEOUT_MS=120000
# Deben ser iguales a MAX_UPLOAD_MB, MAX_PDF_PAGES y MAX_PHOTOS_PER_FIELD del backend (aqui solo se muestran al usuario)
VITE_MAX_UPLOAD_MB=20
VITE_MAX_PDF_PAGES=20
VITE_MAX_PHOTOS_PER_FIELD=5
# Tras dejar de escribir, espera estos ms y guarda el borrador solo
VITE_DRAFT_AUTOSAVE_MS=1500

# Endpoints
VITE_ENDPOINT_HEALTH=/health
VITE_ENDPOINT_TEMPLATES=/poc/templates
VITE_ENDPOINT_TEMPLATE_DETAIL=/poc/templates/{templateId}
VITE_ENDPOINT_TEMPLATE_VERSIONS=/poc/templates/{templateId}/versions
VITE_ENDPOINT_TEMPLATE_VERSION_DETAIL=/poc/templates/{templateId}/versions/{version}
VITE_ENDPOINT_IMPORTS=/poc/imports
VITE_ENDPOINT_IMPORT_DETAIL=/poc/imports/{importId}
VITE_ENDPOINT_RESPONSES=/poc/responses
VITE_ENDPOINT_RESPONSE_DETAIL=/poc/responses/{responseId}
VITE_ENDPOINT_RESPONSE_SUBMIT=/poc/responses/{responseId}/submit
VITE_ENDPOINT_RESPONSE_ATTACHMENTS=/poc/responses/{responseId}/attachments
VITE_ENDPOINT_RESPONSE_ATTACHMENT_DETAIL=/poc/responses/{responseId}/attachments/{attachmentId}
