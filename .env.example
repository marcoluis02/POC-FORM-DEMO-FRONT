# Servidor
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT_MS=15000
# Subir fotos/PDF tarda más que una petición normal
VITE_UPLOAD_TIMEOUT_MS=120000
# Debe ser igual a MAX_UPLOAD_MB del backend
VITE_MAX_UPLOAD_MB=20

# Endpoints
VITE_ENDPOINT_HEALTH=/health
VITE_ENDPOINT_TEMPLATES=/poc/templates
VITE_ENDPOINT_TEMPLATE_DETAIL=/poc/templates/{templateId}
VITE_ENDPOINT_TEMPLATE_VERSIONS=/poc/templates/{templateId}/versions
VITE_ENDPOINT_TEMPLATE_VERSION_DETAIL=/poc/templates/{templateId}/versions/{version}
VITE_ENDPOINT_IMPORTS=/poc/imports
VITE_ENDPOINT_IMPORT_DETAIL=/poc/imports/{importId}
